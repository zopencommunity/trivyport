diff --git a/pkg/fanal/analyzer/secret/secret.go b/pkg/fanal/analyzer/secret/secret.go
index 1234567..89abcde 100644
--- a/pkg/fanal/analyzer/secret/secret.go
+++ b/pkg/fanal/analyzer/secret/secret.go
@@ -107,7 +107,12 @@ func (a *SecretAnalyzer) Analyze(_ context.Context, input analyzer.AnalysisInpu
 	}

-	if size := input.Info.Size(); size > 10485760 { // 10MB
-		log.WithPrefix("secret").Warn("The size of the scanned file is too large. It is recommended to use `--skip-files` for this file to avoid high memory consumption.", log.FilePath(input.FilePath), log.Int64("size (MB)", size/1048576))
-	}
+	maxSecretFileSize := int64(getMaxSecretFileSize())
+	if size := input.Info.Size(); size > maxSecretFileSize {
+		log.WithPrefix("secret").Warn("Skipping secret scan: file exceeds size limit. Use TRIVY_SECRET_MAX_FILE_SIZE to adjust.",
+			log.FilePath(input.FilePath),
+			log.Int64("size (MB)", size/1048576),
+			log.Int64("limit (MB)", maxSecretFileSize/1048576))
+		return nil, nil
+	}

 	filePath := input.FilePath
diff --git a/pkg/fanal/analyzer/secret/secret_maxsize.go b/pkg/fanal/analyzer/secret/secret_maxsize.go
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/pkg/fanal/analyzer/secret/secret_maxsize.go
@@ -0,0 +1,19 @@
+package secret
+
+import (
+	"os"
+	"strconv"
+)
+
+const defaultMaxSecretFileSize = 10 * 1024 * 1024 // 10 MB
+
+// getMaxSecretFileSize returns the maximum file size (in bytes) for secret scanning.
+// Override with TRIVY_SECRET_MAX_FILE_SIZE (in bytes), e.g.:
+//
+//	TRIVY_SECRET_MAX_FILE_SIZE=1048576 trivy fs ...   # 1 MB
+func getMaxSecretFileSize() int {
+	if v, err := strconv.Atoi(os.Getenv("TRIVY_SECRET_MAX_FILE_SIZE")); err == nil && v > 0 {
+		return v
+	}
+	return defaultMaxSecretFileSize
+}
