# bump: trivy-version /TRIVY_VERSION="(.*)"/ https://github.com/aquasecurity/trivy.git|semver:*
TRIVY_VERSION="0.60.0"

###
### Build control file for the trivy port
###

###
### Required Environment Variables
###
export ZOPEN_PROJECT_NAME="trivy"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_STABLE_URL="https://github.com/aquasecurity/trivy.git"
export ZOPEN_STABLE_DEPS="make coreutils wharf git gettext sqlite check_clang"
export ZOPEN_STABLE_TAG="v${TRIVY_VERSION}"

export ZOPEN_DEV_URL=""
export ZOPEN_DEV_DEPS=""

export ZOPEN_CATEGORIES="security devops"
export ZOPEN_RUNTIME_DEPS=""
export ZOPEN_SYSTEM_PREREQ=""

export ZOPEN_COMP="GO"

###
### Build stage control environment variables
###
export ZOPEN_CONFIGURE="skip"
export ZOPEN_MAKE="go"
export ZOPEN_MAKE_OPTS="build -ldflags=-s\ -w\ -X=github.com/aquasecurity/trivy/pkg/version/app.ver=${TRIVY_VERSION} ./cmd/trivy"
export ZOPEN_MAKE_MINIMAL="yes"
export ZOPEN_CHECK="skip"
export ZOPEN_INSTALL="zopen_install"
export ZOPEN_CLEAN="zopen_clean"

zopen_init()
{
  # Keep CC and CXX for building SQLite binding in zopen_wharf
  # unset CC CXX
  export CGO_ENABLED=1
}

zopen_pre_configure()
{
set -x
  cd ..
  # Clone go-sqlite3 if it doesn't exist (like murexport does)
  if [ ! -d "../go-sqlite3" ]; then
    cd ..
    git clone https://github.com/mattn/go-sqlite3.git
    cd go-sqlite3
  else
    cd go-sqlite3
  fi
  
  # Compile sqlite3-binding.c as shared library with z/OS flags
  ${CC:-clang} -shared -fvisibility=default -o sqlite3-binding.so sqlite3-binding.c \
    -DPATH_MAX=1023 \
    -D_AE_BIMODAL=1 \
    -D_ALL_SOURCE \
    -U_ENHANCED_ASCII_EXT \
    -D_ENHANCED_ASCII_EXT=0xFFFFFFFF \
    -D_ISOC99_SOURCE \
    -D_LARGE_TIME_API \
    -D_OPEN_MSGQ_EXT \
    -D_OPEN_SYS_FILE_EXT \
    -D_OPEN_SYS_SOCK_EXT3 \
    -D_OPEN_SYS_SOCK_IPV6 \
    -D_UNIX03_SOURCE \
    -D_UNIX03_THREADS \
    -D_UNIX03_WITHDRAWN \
    -D_XOPEN_SOURCE=600 \
    -D_XOPEN_SOURCE_EXTENDED \
    -fasm \
    -fzos-le-char-mode=ascii \
    -isystem/usr/include \
    -m64
  
  # Tag the side deck file if it exists
  if [ -f sqlite3-binding.x ]; then
    chtag -tc1047 sqlite3-binding.x
  fi
  
  # Replace ZOPEN-REPLACE-DIR placeholder with actual path (like murexport does)
  GO_SQLITE3_DIR="${PWD}"
  sed -i "s|ZOPEN-REPLACE-DIR|${GO_SQLITE3_DIR}|g" sqlite3.go
  
  # Clone and modify go-rpmdb to use mattn/go-sqlite3
  cd ..
  if [ ! -d "go-rpmdb" ]; then
    git clone https://github.com/knqyf263/go-rpmdb.git
  fi
  
  cd go-rpmdb
  
  # Replace glebarez/go-sqlite with mattn/go-sqlite3 in go.mod
  sed -i 's|github.com/glebarez/go-sqlite v1.20.3|github.com/mattn/go-sqlite3 v1.14.24|g' go.mod
  
  # Add blank import for mattn/go-sqlite3 driver registration
  if ! grep -q "github.com/mattn/go-sqlite3" pkg/sqlite3/sqlite3.go; then
    sed -i '/import (/a\	_ "github.com/mattn/go-sqlite3"' pkg/sqlite3/sqlite3.go
  fi
  
  # Initialize Go workspace (like murexport does) - this allows local go-sqlite3 and go-rpmdb to be used
  cd ..

  git clone https://github.com/cheggaaa/pb.git
  git clone https://github.com/syndtr/goleveldb.git
  git clone https://github.com/containerd/continuity.git
  git clone https://github.com/containerd/containerd.git 
  git clone https://github.com/go-git/go-git/v5.git

  rm -f go.work go.work.sum
  go work init ./go-sqlite3 ./go-rpmdb ./trivy ./pb ./goleveldb ./continuity ./containerd ./v5 ./trivy
  
  # Apply go.mod changes to trivy BEFORE running wharf
  cd ./trivy
  
  # Fix grpc module conflict by excluding the duplicate stats/opentelemetry module
  if ! grep -q "exclude google.golang.org/grpc/stats/opentelemetry" go.mod; then
    echo "" >> go.mod
    echo "// Exclude duplicate grpc stats/opentelemetry module to resolve ambiguous import" >> go.mod
    echo "exclude google.golang.org/grpc/stats/opentelemetry v0.0.0-20240907200651-3ffb98b2c93a" >> go.mod
  fi
  
  # Add replace directive for local go-rpmdb
  if ! grep -q "replace github.com/knqyf263/go-rpmdb" go.mod; then
    echo "" >> go.mod
    echo "// Replace go-rpmdb with local version that uses mattn/go-sqlite3 instead of glebarez/go-sqlite" >> go.mod
    echo "replace github.com/knqyf263/go-rpmdb => ../go-rpmdb" >> go.mod
  fi
  
  # Replace modernc.org/sqlite imports with mattn/go-sqlite3 in trivy source files
  sed -i 's|_ "modernc.org/sqlite"|_ "github.com/mattn/go-sqlite3"|g' cmd/trivy/main.go
  sed -i 's|_ "modernc.org/sqlite"|_ "github.com/mattn/go-sqlite3"|g' integration/integration_test.go
  sed -i 's|_ "modernc.org/sqlite"|_ "github.com/mattn/go-sqlite3"|g' pkg/fanal/analyzer/analyzer_test.go
  sed -i 's|_ "modernc.org/sqlite"|_ "github.com/mattn/go-sqlite3"|g' pkg/fanal/analyzer/language/java/jar/jar_test.go
  sed -i 's|_ "modernc.org/sqlite"|_ "github.com/mattn/go-sqlite3"|g' pkg/fanal/test/integration/library_test.go
}

zopen_build()
{
  # Run wharf to patch z/OS platform-specific issues in dependencies
  go mod tidy
  cd ..
  wharf ./trivy/...
  cd ./trivy
  go mod tidy
  
  # Build trivy with CGO enabled
  go build -ldflags="-s -w -X=github.com/aquasecurity/trivy/pkg/version/app.ver=${TRIVY_VERSION}" ./cmd/trivy
}

###
### Required user-supplied functions
###
zopen_check_results()
{
  dir="$1"
  pfx="$2"
  chk="$1/$2_check.log"

  echo "actualFailures:0"
  echo "totalTests:1"
  echo "expectedFailures:0"
  echo "expectedTotalTests:1"
}

zopen_install()
{
  mkdir -p "${ZOPEN_INSTALL_DIR}/bin"
  cp ./trivy "${ZOPEN_INSTALL_DIR}/bin/"
}

zopen_get_version()
{
  echo "${TRIVY_VERSION}"
}

zopen_clean()
{
  rm -f ./trivy
  rm -rf ../.wharf_cache ../wharf_port
}
